# Everything is optional; the defaults are the values chosen by `python -m eval.run_eval`.
# CHUNK_SIZE=150
# TOP_K=2
# MAX_DISTANCE=0.58
# PORT=5050

# Set a key to answer with an OpenAI chat model instead of extracting sentences
# (also: pip install -r requirements-llm.txt)
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
